{
  "expo": {
    "name": "Remote ComfyUI",
    "slug": "remote-comfyui-mobile",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "remote-comfyui",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101827"
      },
      "package": "com.remotecomfyui.mobile",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-image-picker",
      "expo-secure-store",
      "expo-video"
    ]
  }
}
